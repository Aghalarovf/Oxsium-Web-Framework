{
  "Cloudflare WAF / Bot Management": {
    "category": "waf",
    "website": "https://www.cloudflare.com/waf/",
    "headers": [
      {
        "name": "server",
        "pattern": "cloudflare",
        "confidence": 40
      },
      {
        "name": "cf-ray",
        "pattern": ".*",
        "confidence": 60
      },
      {
        "name": "cf-mitigated",
        "pattern": ".*",
        "confidence": 90
      }
    ],
    "cookies": [
      {
        "name": "^__cf_bm$",
        "confidence": 85
      },
      {
        "name": "^__cfduid$",
        "confidence": 70
      },
      {
        "name": "^cf_clearance$",
        "confidence": 90
      }
    ],
    "html": [
      {
        "type": "body",
        "pattern": "Attention Required! \\| Cloudflare|Sorry, you have been blocked",
        "confidence": 90
      },
      {
        "type": "body",
        "pattern": "cdn-cgi/challenge-platform",
        "confidence": 85
      }
    ]
  },
